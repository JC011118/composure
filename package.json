{
  "name": "composure",
  "productName": "Composure",
  "version": "0.1.0",
  "private": true,
  "description": "Interview rehearsal room that trains recovery, using live camera signals from the SmartSpectra SDK, all on-device.",
  "keywords": [
    "electron",
    "smartspectra",
    "interview",
    "rehearsal"
  ],
  "license": "MIT",
  "author": {
    "name": "Composure contributors"
  },
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "electron-forge start --",
    "start": "electron-forge start --",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "lint": "oxlint --deny-warnings src tests scripts && npm run typecheck",
    "format": "oxfmt --write src tests scripts",
    "format:check": "oxfmt --check src tests scripts",
    "fixtures:generate": "vite-node scripts/generate-replay-fixture.ts",
    "headless-check": "node scripts/headless-check.mjs",
    "smoke": "node scripts/smoke-sim.mjs"
  },
  "dependencies": {
    "@smartspectra/node-sdk": "3.4.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "45.2.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.92.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-node": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
